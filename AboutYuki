
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Yuki Fuyu Tokito | Frost Pillar</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Quicksand:wght@400;500;600;700&display=swap');

:root {
  --ice: #bceaff;
  --blue: #65b9e8;
  --dark: #102c49;
  --navy: #07182b;
  --white: #f5fbff;
  --silver: #d8e9f5;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  scroll-behavior: smooth;
}

body {
  background: linear-gradient(145deg, #07182b, #123b5c, #102a48);
  color: var(--white);
  font-family: 'Quicksand', sans-serif;
  overflow-x: hidden;
}

/* FALLING SNOW */

.snow {
  position: fixed;
  top: -25px;
  color: #d8f3ff;
  pointer-events: none;
  z-index: 10;
  animation: snowfall linear infinite;
  opacity: .8;
}

@keyframes snowfall {
  to {
    transform: translateY(110vh) rotate(360deg);
  }
}

/* NAVIGATION */

nav {
  position: sticky;
  top: 0;
  z-index: 20;
  background: rgba(5,20,38,.94);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid #80cfff44;
  padding: 15px 5%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
}

.logo {
  font-family: Cinzel, serif;
  color: var(--ice);
  font-size: 19px;
  font-weight: bold;
}

.navlinks {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
}

.navlinks a {
  text-decoration: none;
  color: white;
  font-size: 13px;
  transition: .3s;
}

.navlinks a:hover {
  color: var(--ice);
}

/* HERO */

.hero {
  min-height: 90vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 65px 20px;
  background: radial-gradient(
    ellipse at center,
    #4e9ac044,
    transparent 65%
  );
}

.hero-symbol {
  font-size: 80px;
  filter: drop-shadow(0 0 20px #a9e5ff);
  animation: float 4s ease-in-out infinite;
}

@keyframes float {
  50% { transform: translateY(-12px); }
}

.hero h1 {
  font-family: Cinzel, serif;
  font-size: clamp(35px,7vw,75px);
  letter-spacing: 5px;
  color: #e3f7ff;
  text-shadow: 0 0 25px #65b9e8;
  margin: 15px 0;
}

.hero h2 {
  font-family: Cinzel, serif;
  font-size: 20px;
  color: var(--ice);
  letter-spacing: 5px;
}

.hero p {
  max-width: 600px;
  line-height: 1.9;
  margin: 25px auto;
  color: #d4e8f7;
}

/* BUTTONS */

.btn {
  display: inline-block;
  padding: 13px 27px;
  margin: 8px;
  border-radius: 30px;
  border: 1px solid #bceaff;
  background: linear-gradient(120deg,#8bd5fa,#367eae);
  color: #07182b;
  text-decoration: none;
  font-weight: bold;
  cursor: pointer;
  transition: .3s;
}

.btn:hover {
  transform: translateY(-4px);
  box-shadow: 0 0 22px #8bd5fa;
}

/* SECTIONS */

section {
  padding: 75px 8%;
  scroll-margin-top: 75px;
}

.section-title {
  text-align: center;
  font-family: Cinzel, serif;
  color: var(--ice);
  font-size: clamp(25px,4vw,38px);
  margin-bottom: 15px;
}

.subtitle {
  text-align: center;
  color: #b7d5e9;
  margin-bottom: 40px;
  line-height: 1.7;
}

.panel {
  background: linear-gradient(140deg,#ffffff12,#9bdcff0a);
  border: 1px solid #a5ddff44;
  border-radius: 20px;
  padding: 27px;
  box-shadow: 0 8px 35px #0003;
  backdrop-filter: blur(8px);
}

/* ABOUT */

.about-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(230px,1fr));
  gap: 18px;
}

.info h3 {
  color: var(--ice);
  font-family: Cinzel,serif;
  margin-bottom: 12px;
}

.info p {
  line-height: 1.9;
  color: #d7eafa;
}

.info strong {
  color: #a9ddff;
}

/* BREATHING FORMS */

.ability {
  text-align: center;
  max-width: 850px;
  margin: auto;
}

.ability-symbol {
  font-size: 60px;
  margin-bottom: 15px;
}

.forms {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(190px,1fr));
  gap: 15px;
  margin-top: 30px;
}

.form-card {
  padding: 20px;
  border: 1px solid #9bdcff55;
  background: #8bd5fa12;
  border-radius: 15px;
  text-align: center;
  transition: .3s;
}

.form-card:hover {
  transform: translateY(-5px);
  background: #8bd5fa25;
  box-shadow: 0 0 18px #8bd5fa33;
}

.form-card h3 {
  color: var(--ice);
  font-family: Cinzel,serif;
  font-size: 15px;
  margin-bottom: 10px;
}

.form-card p {
  font-size: 14px;
  color: #d7eafa;
  line-height: 1.6;
}

/* RELATIONSHIPS */

.relationship-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(225px,1fr));
  gap: 17px;
}

.relation {
  border: 1px solid #91d5ff44;
  border-radius: 17px;
  background: linear-gradient(145deg,#ffffff12,#a6dfff0a);
  padding: 20px;
  transition: .3s;
}

.relation:hover {
  transform: translateY(-5px);
  border-color: var(--ice);
  box-shadow: 0 0 20px #79c9f533;
}

.relation h3 {
  font-family: Cinzel,serif;
  color: var(--ice);
  margin-bottom: 10px;
  font-size: 17px;
}

.relation p {
  color: #d7eafa;
  line-height: 1.7;
  font-size: 14px;
}

.tag {
  display: inline-block;
  font-size: 11px;
  padding: 5px 10px;
  background: #87cfff25;
  border: 1px solid #a4dfff66;
  color: #c4ebff;
  border-radius: 20px;
  margin-bottom: 12px;
}

/* GRANDFATHERS */

.grandpa {
  border-left: 3px solid #a7ddff;
}

.grandpa h3 {
  font-size: 19px;
}

.nickname {
  color: #bceaff;
  font-style: italic;
  margin-top: 10px;
}

/* QUOTE */

.quote {
  text-align: center;
  font-family: Cinzel,serif;
  font-size: 21px;
  line-height: 1.8;
  color: #d4f1ff;
  max-width: 700px;
  margin: auto;
  text-shadow: 0 0 15px #7ecfff55;
}

/* COMMUNITY */

.community {
  text-align: center;
}

.community p {
  line-height: 1.8;
  margin: 15px auto;
  max-width: 600px;
  color: #d7eafa;
}

.social-heading {
  color: var(--ice);
  font-family: Cinzel,serif;
  margin-top: 30px;
  margin-bottom: 10px;
}

/* FOOTER */

footer {
  padding: 30px 15px;
  text-align: center;
  border-top: 1px solid #8bd5fa44;
  color: #b5d9ed;
  line-height: 2;
  font-size: 13px;
}

/* MOBILE */

@media(max-width:650px) {
  nav {
    flex-direction: column;
  }

  .navlinks {
    justify-content: center;
    gap: 12px;
  }

  .navlinks a {
    font-size: 12px;
  }

  section {
    padding: 55px 5%;
  }
}
</style>
</head>

